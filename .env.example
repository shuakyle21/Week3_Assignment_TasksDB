# Copy this file to .env before running `docker compose up`:
#   cp .env.example .env
#
# .env is gitignored, so your real database password never gets committed.
# These are safe throwaway values for local development — change the password
# for anything that isn't a disposable local container.

POSTGRES_USER=taskuser
POSTGRES_PASSWORD=changeme
POSTGRES_DB=tasks
DATABASE_URL=postgresql://taskuser:changeme@localhost:5432/tasks
